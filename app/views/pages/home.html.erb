<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lingualogic - Landing Page</title>

    <link rel="stylesheet" href="style.css">
</head>
<body>


    <header>
        <nav>
            <h1>Lingua Logic</h1>

        </nav>
    </header>

    <!-- Hero Section (Main attention area) -->
    <section id="hero">
        <div class="hero-content">
            <h2>Welcome to the Fun way of coding</h2>
            <p>Coding logic has never been this fun! Try it now!</p>
            <!-- Call to Action Button -->
            <%= link_to "Play Now!", new_monster_path, class: "cta-button" %>
        </div>
        <!-- Placeholder for a hero image or video -->
        <div class="hero-media">
            <!-- Add an <img> tag or <video> tag here -->
            <%= image_tag "placeholder-hero.png", alt: "Placeholder"%>
        </div>
    </section>

    <!-- About/Description Section -->
    <section id="about">
        <h3>About the Game</h3>
        <p>Dive deep into the world of lingualand. Explore the story, the challenges, and the excitement.</p>
    </section>

    <!-- Features Section -->

    <!-- Download/CTA Section -->
    <%# <section id="download">
        <h3>Ready to Play?</h3>
        <p>Download [Game Name] now and start your adventure.</p>
        <a href="link-to-game-file" class="cta-button">Download Now</a>
    </section> %>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Lingualogic Game Inc. All rights reserved.</p>
        <!-- Add social media links here -->
    </footer>

    <!-- Link to your JavaScript file for interactivity (if any) -->
    <script src="script.js"></script>

</body>
</html>
