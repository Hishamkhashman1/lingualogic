<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lingualogic - Landing Page</title>

    <link rel="stylesheet" href="style.css">
</head>
<body class="landing-page">


    <div class="landing-shell">
        <main class="landing-main">
        <!-- Hero Section (Main attention area) -->
        <section id="hero" class="landing-hero">
            <div class="landing-hero-panel landing-hero-text">
                <div class="hero-content landing-hero-content">
                    <h2>Welcome to the Fun way of coding</h2>
                    <p>Turn coding into an adventure.
Solve challenges, guide your monster, and unlock new quests while learning real programming logic.</p>
                    <!-- Call to Action Button -->
                    <div class="landing-cta">
                        <%= link_to "Play Now!", student_signed_in? ? new_monster_path : new_student_session_path, class: "cta-button" %>
                    </div>
                </div>
            </div>
            <!-- Placeholder for a hero image or video -->
            <div class="landing-hero-panel landing-hero-preview">
                <div class="landing-preview-frame">
                    <div class="hero-media landing-hero-media">
                        <!-- Add an <img> tag or <video> tag here -->
                        <%= image_tag "placeholder-hero.png", alt: "Placeholder"%>
                    </div>
                </div>
            </div>
        </section>

        <!-- About/Description Section -->
        <section id="about" class="landing-about">
            <div class="landing-about-panel">
                <div class="landing-about-content">
                    <h3>About the Game</h3>
                    <p>Enter Lingualand, a playful world where logic and creativity power your journey.

Guide your monster using simple commands, solve coding challenges, and unlock new levels as your skills grow.

Perfect for beginners, curious minds, and anyone who wants to learn coding in a fun and interactive way.</p>
                </div>
            </div>
        </section>
        </main>

    <!-- Features Section -->

    <!-- Download/CTA Section -->
    <%# <section id="download">
        <h3>Ready to Play?</h3>
        <p>Download [Game Name] now and start your adventure.</p>
        <a href="link-to-game-file" class="cta-button">Download Now</a>
    </section> %>

    <!-- Footer -->
        <footer class="landing-footer">
            <div class="landing-footer-inner">
                <p>&copy; 2026 Lingualogic Game Inc. All rights reserved.</p>
                <!-- Add social media links here -->
            </div>
        </footer>
    </div>

    <!-- Link to your JavaScript file for interactivity (if any) -->
    <script src="script.js"></script>

</body>
</html>
