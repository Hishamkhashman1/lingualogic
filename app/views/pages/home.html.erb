<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lingualogic - Landing Page</title>

    <link rel="stylesheet" href="style.css">
</head>
<body class="landing-page">


    <div class="landing-shell">
        <main class="landing-main">
        <!-- Hero Section (Main attention area) -->
        <section id="hero" class="landing-hero">
            <div class="landing-hero-panel landing-hero-text">
                <div class="hero-content landing-hero-content">
                    <h2><%= t("home.hero_title") %></h2>
                    <p><%= t("home.hero_body") %></p>
                    <!-- Call to Action Button -->
                    <div class="landing-cta">
                        <% play_now_target = student_signed_in? ? :new_monster_path : :new_student_session_path %>
                        <button type="button" class="cta-button landing-lang-trigger" data-lang-modal-open>
                          <%= t("home.play_now") %>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Placeholder for a hero image or video -->
            <div class="landing-hero-panel landing-hero-preview">
                <div class="landing-preview-frame">
                    <div class="hero-media landing-hero-media">
                        <!-- Add an <img> tag or <video> tag here -->
                        <%= image_tag "placeholder-hero.png", alt: "Placeholder"%>
                    </div>
                </div>
            </div>
        </section>

        <!-- About/Description Section -->
        <section id="about" class="landing-about">
            <div class="landing-about-panel">
                <div class="landing-about-content">
                    <h3><%= t("home.about_title") %></h3>
                    <p><%= t("home.about_body") %></p>
                </div>
            </div>
        </section>
        </main>

    <!-- Features Section -->

    <!-- Download/CTA Section -->
    <%# <section id="download">
        <h3>Ready to Play?</h3>
        <p>Download [Game Name] now and start your adventure.</p>
        <a href="link-to-game-file" class="cta-button">Download Now</a>
    </section> %>

    <!-- Footer -->
        <footer class="landing-footer">
            <div class="landing-footer-inner">
                <p><%= t("home.footer") %></p>
                <!-- Add social media links here -->
            </div>
        </footer>
    </div>

    <div class="landing-lang-modal" aria-hidden="true" role="dialog" aria-label="<%= t("home.lang.title") %>" data-lang-modal>
      <div class="landing-lang-backdrop" data-lang-modal-close></div>
      <div class="landing-lang-panel">
        <button type="button" class="landing-lang-close" aria-label="<%= t("home.lang.close") %>" data-lang-modal-close>
          ×
        </button>
        <h3 class="landing-lang-title"><%= t("home.lang.title") %></h3>
        <p class="landing-lang-subtitle"><%= t("home.lang.subtitle") %></p>
        <div class="landing-lang-list">
          <%= link_to public_send(play_now_target, locale: :en), class: "landing-lang-option" do %>
            <span class="landing-lang-flag" aria-hidden="true">🇬🇧</span>
            <span class="landing-lang-label"><%= t("home.lang.english") %></span>
          <% end %>
          <%= link_to public_send(play_now_target, locale: :ja), class: "landing-lang-option" do %>
            <span class="landing-lang-flag" aria-hidden="true">🇯🇵</span>
            <span class="landing-lang-label"><%= t("home.lang.japanese") %></span>
          <% end %>
          <%= link_to public_send(play_now_target, locale: :fr), class: "landing-lang-option" do %>
            <span class="landing-lang-flag" aria-hidden="true">🇫🇷</span>
            <span class="landing-lang-label"><%= t("home.lang.french") %></span>
          <% end %>
          <%= link_to public_send(play_now_target, locale: :es), class: "landing-lang-option" do %>
            <span class="landing-lang-flag" aria-hidden="true">🇲🇽</span>
            <span class="landing-lang-label"><%= t("home.lang.spanish") %></span>
          <% end %>
          <%= link_to public_send(play_now_target, locale: :ar), class: "landing-lang-option", dir: "rtl" do %>
            <span class="landing-lang-flag" aria-hidden="true">🇯🇴</span>
            <span class="landing-lang-label"><%= t("home.lang.arabic") %></span>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Link to your JavaScript file for interactivity (if any) -->
    <script src="script.js"></script>
    <script>
      (function () {
        var modal = document.querySelector("[data-lang-modal]");
        var openBtn = document.querySelector("[data-lang-modal-open]");
        var closeEls = document.querySelectorAll("[data-lang-modal-close]");
        if (!modal || !openBtn) return;

        var openModal = function () {
          modal.classList.add("is-open");
          modal.setAttribute("aria-hidden", "false");
        };

        var closeModal = function () {
          modal.classList.remove("is-open");
          modal.setAttribute("aria-hidden", "true");
        };

        openBtn.addEventListener("click", function (event) {
          event.preventDefault();
          openModal();
        });

        closeEls.forEach(function (el) {
          el.addEventListener("click", function () {
            closeModal();
          });
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") closeModal();
        });
      })();
    </script>

</body>
</html>
