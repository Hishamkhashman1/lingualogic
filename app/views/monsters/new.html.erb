<div class="monster-container starter-screen">
  <h1 class="starter-title"><%= t("monsters.new.title") %></h1>

  <%= simple_form_for @monster do |f| %>
    <div class="starter-grid" role="radiogroup" aria-label="<%= t("monsters.new.aria_selection") %>">
      <div class="starter-option">
        <%= f.radio_button :species_type, "cat", id: "starter-cat", class: "starter-radio" %>
        <label for="starter-cat" class="starter-card">
          <span class="starter-selected"><%= t("monsters.new.selected") %></span>
          <div class="starter-image">
            <%= image_tag "pixel-monster-nobkg.png", alt: "Pixel Cat", size: "160x160" %>
          </div>
          <div class="starter-name"><%= t("monsters.new.cat_name") %></div>
          <div class="starter-desc"><%= t("monsters.new.cat_desc") %></div>
        </label>
      </div>

      <div class="starter-option">
        <%= f.radio_button :species_type, "fox", id: "starter-fox", class: "starter-radio" %>
        <label for="starter-fox" class="starter-card">
          <span class="starter-selected"><%= t("monsters.new.selected") %></span>
          <div class="starter-image">
            <%= image_tag "fox-fornt-nobkg.png", alt: "Cyber Fox", size: "160x160" %>
          </div>
          <div class="starter-name"><%= t("monsters.new.fox_name") %></div>
          <div class="starter-desc"><%= t("monsters.new.fox_desc") %></div>
        </label>
      </div>

      <div class="starter-option">
        <%= f.radio_button :species_type, "guinea_pig", id: "starter-gpig", class: "starter-radio" %>
        <label for="starter-gpig" class="starter-card">
          <span class="starter-selected"><%= t("monsters.new.selected") %></span>
          <div class="starter-image">
            <%= image_tag "gpig-front-nobkg.png", alt: "Purple Guinea Pig", size: "160x160" %>
          </div>
          <div class="starter-name"><%= t("monsters.new.gpig_name") %></div>
          <div class="starter-desc"><%= t("monsters.new.gpig_desc") %></div>
        </label>
      </div>
    </div>

    <%= f.input :name, label: t("monsters.new.name_label") %>
    <%= f.submit t("monsters.new.submit"), class: "cta-button" %>
  <% end %>
</div>

<style>
  .starter-screen {
    color: #e9f5f5;
  }

  .starter-title {
    margin-bottom: 16px;
  }

  .starter-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 22px;
  }

  .starter-option {
    position: relative;
  }

  .starter-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .starter-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 18px 16px;
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(8, 18, 24, 0.95), rgba(6, 10, 14, 0.98));
    border: 1px solid rgba(46, 255, 214, 0.18);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), inset 0 0 0 rgba(46, 255, 214, 0);
    transition: transform 250ms ease, box-shadow 250ms ease, border-color 250ms ease, filter 300ms ease, opacity 250ms ease;
    cursor: pointer;
    min-height: 260px;
  }

  .starter-card:hover {
    transform: translateY(-4px);
    border-color: rgba(46, 255, 214, 0.45);
  }

  .starter-radio:focus-visible + .starter-card {
    outline: 2px solid rgba(46, 255, 214, 0.65);
    outline-offset: 3px;
  }

  .starter-radio:checked + .starter-card {
    transform: scale(1.06) translateY(-4px);
    border-color: rgba(46, 255, 214, 0.8);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5), 0 0 30px rgba(46, 255, 214, 0.55);
    z-index: 2;
  }

  .starter-radio:checked + .starter-card .starter-selected {
    opacity: 1;
    transform: translateY(0);
  }

  .starter-selected {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.04em;
    background: rgba(46, 255, 214, 0.15);
    color: #2effd6;
    border: 1px solid rgba(46, 255, 214, 0.45);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .starter-grid {
    position: relative;
  }

  .starter-grid:has(.starter-radio:checked)::before {
    content: "";
    position: absolute;
    inset: -12px;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.35) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .starter-grid:has(.starter-radio:checked) .starter-card {
    opacity: 0.5;
    filter: blur(2px) grayscale(0.35);
    transform: scale(0.97);
  }

  .starter-grid:has(.starter-radio:checked) .starter-radio:checked + .starter-card {
    opacity: 1;
    filter: none;
    transform: scale(1.06) translateY(-4px);
  }

  .starter-image {
    height: 239px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .starter-image img {
    width: 160px;
    height: 239px;
    object-fit: contain;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.45));
  }

  .starter-name {
    margin-top: 12px;
    font-weight: 700;
    font-size: 18px;
    color: #e7ffff;
    text-align: center;
  }

  .starter-desc {
    margin-top: 6px;
    font-size: 13px;
    color: rgba(233, 245, 245, 0.7);
    text-align: center;
  }

  @media (max-width: 900px) {
    .starter-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
