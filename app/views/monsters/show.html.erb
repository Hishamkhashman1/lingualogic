<div class="monster-container tama-shell" data-controller="task-status" data-task-status-monster-id-value="<%= @monster.id %>">
  <div class="tama-screen">
    <div class="tama-hud">
      <div class="tama-title">
        <h1 class="tama-name"><%= @monster.name %></h1>
      </div>
      <div class="tama-bars">
        <div class="tama-bar" data-controller="health-animate" data-health-animate-monster-id-value="<%= @monster.id %>" data-health-animate-current-value="<%= @monster.health %>">
          <span class="tama-bar-label">Health</span>
          <span class="tama-bar-track" data-health-animate-target="track">
            <span class="tama-bar-fill" data-health-animate-target="bar" style="width:<%= @monster.health %>%"></span>
          </span>
        </div>
        <div class="tama-bar">
          <span class="tama-bar-label">Energy</span>
          <span class="tama-bar-track">
            <span class="tama-bar-fill tama-bar-fill--energy" style="width: <%= @monster.energy %>%"></span>
          </span>
        </div>
      </div>
    </div>

    <div class="tama-inventory" data-controller="inventory-popup inventory-wearing" data-inventory-wearing-wearing-value="<%= @monster.accessory %>">
      <button
        type="button"
        class="tama-inventory-trigger"
        data-inventory-popup-target="trigger"
        data-action="click->inventory-popup#toggle"
        aria-expanded="false"
        aria-controls="monster-inventory-panel"
      >
        My Items
      </button>
      <div
        class="tama-inventory-backdrop"
        data-inventory-popup-target="backdrop"
        data-action="click->inventory-popup#close"
        aria-hidden="true"
      ></div>
      <div
        id="monster-inventory-panel"
        class="tama-inventory-panel"
        data-inventory-popup-target="panel"
        role="dialog"
        aria-modal="true"
        aria-label="My Items"
        aria-hidden="true"
      >
        <div class="tama-inventory-header">
          <span class="tama-inventory-title">My Items</span>
          <button
            type="button"
            class="tama-inventory-close"
            data-action="click->inventory-popup#close"
            aria-label="Close inventory"
          >
            Close
          </button>
        </div>

        <div id="inventory-wearing">
          <span class="tama-inventory-wearing"> Now wearing: <%= @monster.accessory %> </span>
        </div>

        <div class="tama-inventory-list">
          <% if @my_items.present? %>
            <% @my_items.each do |item| %>
              <% current_item = Item.find(item.item_id) %>
              <div class="tama-inventory-item">
                <div class="tama-inventory-media">
                  <% if current_item.image.present? %>
                    <%= image_tag File.basename(current_item.image), alt: "item", size: "56x56" %>
                  <% end %>
                </div>
                <div class="tama-inventory-meta">
                  <span class="tama-inventory-name"><%= current_item.name %></span>
                  <span class="tama-inventory-qty">Qty <%= item.qty %></span>
                </div>
                      <%#  equip items by updating Monster.accessory %>
                  <% if current_item.accessory == true %>
                    <div class="button-equip">
                      <%= button_to "Equip", equip_monster_path(@monster), method: :patch, params: { item_id: current_item.id}, form: {data: {page_transition_ignore: true}} %>
                      <%# set @monster.accessory to @current_item.name %>
                    </div>
                  <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="tama-inventory-empty">No items yet.</div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="tama-monster">
      <div class="tama-monster-wrap">
        <div class="tama-monster-sprite" role="img" aria-label="pixel Monster"></div>
        <% if @notifications.any? %>
  <% @notifications.each do |notification| %>
    <div class="tama-notification">
      <span><%= notification.message %></span>

      <% if notification.task %>
        <%= button_to "Do Task",
        monster_monster_tasks_path(@monster),
        params: { monster_task: { task_id: notification.task.id } },
        class: "tama-task-button",
        data: { task_status_target: "button", task_id: notification.task.id } %>
      <% end %>

    </div>
  <% end %>
<% end %>
      </div>
    </div>

    <div class="monster-info tama-quests">
      <% if @tasks.present? %>
        <div class="tama-quest-list">
          <% @tasks.each_with_index do |task, index| %>
            <div class="tama-quest">
              <div class="tama-quest-text">
                <% if index == 0 %>
                <span class="tama-quest-label">Cyborg says:</span>
                <% end %>

              <div class="tama-quest-meta">
                <span class="tama-quest-level">LV. <%= task.difficulty %></span>
                <span class="tama-quest-difficulty">
                  <% if task.difficulty == 1 %>
                    EASY
                  <% elsif task.difficulty > 2 && task.difficulty < 5 %>
                    MEDIUM
                  <% elsif task.difficulty == 5 %>
                    DIFFICULT
                  <% else %>
                    PRO
                  <% end %>
                </span>
              </div>



      <span class="tama-quest-goal">
      "<%= link_to task.goal, monster_monster_tasks_path(@monster, monster_task: { task_id: task.id }), method: :post %>"
      </span>
      </div>
              <div class="tama-quest-action">
                <%= simple_form_for [@monster, MonsterTask.new] do |f| %>
                  <%= f.input :task_id, as: :hidden, input_html: { value: task.id } %>
                  <%= f.submit "Do Task", class: "tama-start", data: { task_status_target: "button", task_id: task.id } %>
                <% end %>
              </div>
              <div class="tama-hint">Press START to begin</div>
            </div>

            </div>
          <% end %>
        </div>
      <% end %>
      </div>

    </div>
  </div>

  <div class="tama-quests tama-quests--duplicate">
    <% @tasks.each do |task| %>
      <%= task.goal %>
      <%= simple_form_for [@monster, MonsterTask.new] do |f| %>
        <%= f.input :task_id, as: :hidden, input_html: { value: task.id } %>
        <%= f.submit "Do Task", data: { task_status_target: "button", task_id: task.id } %>
      <% end %>
    <% end %>
  </div>
</div>

<style>
.tama-notification {
  position: absolute;
  top: -50px;
  right: 200px;

  display: inline-block;
  max-width: 160px;

  padding: 10px 12px;

  border-radius: 12px;
  border: 1px solid var(--theme-accent);
  background: rgba(8, 14, 22, 0.95);
  box-shadow: 0 0 10px rgba(57, 244, 183, 0.25);

  font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;

  text-align: center;
}

.tama-notification span {
  display: block;
  margin-bottom: 8px;
}

.tama-notification form {
  display: flex;
  justify-content: center;
}

.tama-notification button {
  font-size: 0.6rem;
  padding: 5px 10px;
}

.tama-notification::after {
  content: "";
  position: absolute;

  left: 14px;
  bottom: -6px;

  width: 10px;
  height: 10px;

  background: rgba(8, 14, 22, 0.95);
  border-left: 1px solid var(--theme-accent);
  border-bottom: 1px solid var(--theme-accent);

  transform: rotate(45deg);
}

  .tama-notification::after {
    content: "";
    position: absolute;
    bottom: -7px;
    left: 18px;
    width: 12px;
    height: 12px;
    background: rgba(8, 14, 22, 0.95);
    border-left: 1px solid var(--theme-accent);
    border-bottom: 1px solid var(--theme-accent);
    transform: rotate(315deg);
    }

.tama-task-button {
  padding: 4px 10px;
  font-size: 0.65rem;
  border-radius: 8px;
  letter-spacing: 0.1em;
  min-width: auto;
  margin-top: 8px;

  box-shadow: 0 0 6px rgba(57, 244, 183, 1);
}
</style>
