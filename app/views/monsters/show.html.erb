<div class="monster-container tama-shell">
  <div class="tama-screen">
    <div class="tama-hud">
      <div class="tama-title">
        <h1 class="tama-name"><%= @monster.name %></h1>
      </div>
      <div class="tama-bars">
        <div class="tama-bar">
          <span class="tama-bar-label">Health</span>
          <span class="tama-bar-track">
            <span class="tama-bar-fill" style="width:<%= @monster.health %>%"></span>
          </span>
        </div>
        <div class="tama-bar">
          <span class="tama-bar-label">Energy</span>
          <span class="tama-bar-track">
            <span class="tama-bar-fill tama-bar-fill--energy" style="width: <%= @monster.energy %>%"></span>
          </span>
        </div>
      </div>
    </div>

    <div class="tama-inventory" data-controller="inventory-popup">
      <button
        type="button"
        class="tama-inventory-trigger"
        data-inventory-popup-target="trigger"
        data-action="click->inventory-popup#toggle"
        aria-expanded="false"
        aria-controls="monster-inventory-panel"
      >
        My Items
      </button>
      <div
        class="tama-inventory-backdrop"
        data-inventory-popup-target="backdrop"
        data-action="click->inventory-popup#close"
        aria-hidden="true"
      ></div>
      <div
        id="monster-inventory-panel"
        class="tama-inventory-panel"
        data-inventory-popup-target="panel"
        role="dialog"
        aria-modal="true"
        aria-label="My Items"
        aria-hidden="true"
      >
        <div class="tama-inventory-header">
          <span class="tama-inventory-title">My Items</span>
          <button
            type="button"
            class="tama-inventory-close"
            data-action="click->inventory-popup#close"
            aria-label="Close inventory"
          >
            Close
          </button>
        </div>
        <div class="tama-inventory-list">
          <% if @my_items.present? %>
            <% @my_items.each do |item| %>
              <% current_item = Item.find(item.item_id) %>
              <div class="tama-inventory-item">
                <div class="tama-inventory-media">
                  <% if current_item.image.present? %>
                    <%= image_tag File.basename(current_item.image), alt: "item", size: "56x56" %>
                  <% end %>
                </div>
                <div class="tama-inventory-meta">
                  <span class="tama-inventory-name"><%= current_item.name %></span>
                  <span class="tama-inventory-qty">Qty <%= item.qty %></span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="tama-inventory-empty">No items yet.</div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="tama-monster">
      <div class="tama-monster-wrap">
        <%= image_tag "monster-pixel-1.png", alt: "pixel Monster", size: "240x280" %>
      </div>
    </div>

    <div class="monster-info tama-quests">
      <% if @tasks.present? %>
        <div class="tama-quest-list">
          <% @tasks.each_with_index do |task, index| %>
            <div class="tama-quest">
              <div class="tama-quest-text">
                <% if index == 0 %>
                <span class="tama-quest-label">Cyborg says:</span>
                <% end %>

                <div class="tama-quest-meta">
                  <span class="tama-quest-level">lv. 5</span>
                  <span class="tama-quest-difficulty">DIFFICULT</span>
                </div>

      <span class="tama-quest-goal">
      "<%= link_to task.goal, monster_monster_tasks_path(@monster, monster_task: { task_id: task.id }), method: :post %>"
      </span>
      </div>
              <div class="tama-quest-action">
                <%= simple_form_for [@monster, MonsterTask.new] do |f| %>
                  <%= f.input :task_id, as: :hidden, input_html: { value: task.id } %>
                  <%= f.submit "Do Task", class: "tama-start" %>
                <% end %>
              </div>
              <div class="tama-hint">Press START to begin</div>
            </div>

            </div>
          <% end %>
        </div>
      <% end %>
      </div>

    </div>
  </div>

  <div class="tama-quests tama-quests--duplicate">
    <% @tasks.each do |task| %>
      <%= task.goal %>
      <%= simple_form_for [@monster, MonsterTask.new] do |f| %>
        <%= f.input :task_id, as: :hidden, input_html: { value: task.id } %>
        <%= f.submit "Do Task" %>
      <% end %>
    <% end %>
  </div>
</div>

