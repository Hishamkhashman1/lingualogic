<!DOCTYPE html>
<html>

<head>
  <script src="https://cdn.jsdelivr.net/npm/phaser@3.60.0/dist/phaser-arcade-physics.min.js"></script>
  <%= javascript_import_module_tag "tasks/test" %>
</head>

<body>
<%= link_to "Play Now!", new_monster_path, class: "cta-button" %>
  <h1> This is a task. </h1>

  <div id="task-info">
    <h2> Task Name </h2>
    <%= @monster_task.task.goal %>
    <p> Level: # </p>
    <p> Task information and instructions go here. </p>
  </div>

  <div id="task-phaserjs">
    <p> Task goes here </p>
  </div>

  <h2 id="message"></h2>
  <p id='speed-display'> Speed: </p>

  <div id="task-control">
    <button id="speed+"> + Speed </button>
    <button id="speed-"> - Speed </button>
  </div>

  <p>v3 </p>

</html>
</body>
