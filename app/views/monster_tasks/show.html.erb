<!DOCTYPE html>
<html>

<head>
  <script src="https://cdn.jsdelivr.net/npm/phaser@3.60.0/dist/phaser-arcade-physics.min.js"></script>
  <%= javascript_import_module_tag "tasks/task1" %>
  <%= javascript_import_module_tag "tasks/platform" %>
  <style>
    .has-tooltip {
      position: relative;
      cursor: help;
    }

    .has-tooltip::after {
      content: attr(data-tooltip);
      position: absolute;
      bottom: 120%;
      left: 50%;
      transform: translateX(-50%) scale(0.95);
      background: rgba(8, 14, 22, 0.95);
      border: 1px solid rgba(57, 244, 183, 0.6);
      border-radius: 12px;
      padding: 14px 18px;
      width: max-content;
      max-width: 360px;
      font-size: 18px;
      line-height: 1.6;
      font-weight: 500;
      color: #cffff6;
      box-shadow: 0 0 12px rgba(57, 244, 183, 0.35), 0 6px 20px rgba(0, 0, 0, 0.6);
      opacity: 0;
      pointer-events: none;
      transition: all 0.2s ease;
      text-align: center;
      white-space: normal;
      z-index: 30;
    }

    .has-tooltip::before {
      content: "";
      position: absolute;
      bottom: 112%;
      left: 50%;
      transform: translateX(-50%);
      border-width: 8px;
      border-style: solid;
      border-color: rgba(57, 244, 183, 0.6) transparent transparent transparent;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .has-tooltip:hover::after,
    .has-tooltip:hover::before {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }

    #task-mini-challenge:has(.has-tooltip:hover)::after,
    #task-mini-challenge:has(.has-tooltip:hover)::before {
      opacity: 0;
      transform: translateX(-50%) scale(0.95);
    }

    .tooltip-wrap {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .tooltip-wrap--block {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      width: 100%;
    }

    .tooltip-wrap--block > .has-tooltip {
      flex: 1;
      min-width: 0;
    }

    .speak-btn {
      width: 24px;
      height: 24px;
      border-radius: 999px;
      border: 1px solid rgba(57, 244, 183, 0.6);
      background: rgba(8, 14, 22, 0.85);
      color: #cffff6;
      font-size: 13px;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      box-shadow: 0 0 8px rgba(57, 244, 183, 0.28), 0 0 14px rgba(90, 200, 255, 0.2);
    }

    .speak-btn:hover,
    .speak-btn:focus-visible {
      box-shadow: 0 0 12px rgba(57, 244, 183, 0.45), 0 0 20px rgba(90, 200, 255, 0.3);
      outline: none;
    }

    .speak-btn--pill {
      position: absolute;
      top: -6px;
      right: -6px;
      width: 20px;
      height: 20px;
      font-size: 11px;
    }

    #task-complete-modal {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(6, 12, 18, 0.65);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 80;
    }

    #task-complete-card {
      width: min(520px, 92vw);
      padding: 22px 24px;
      border-radius: 16px;
      border: 1px solid rgba(57, 244, 183, 0.55);
      background: rgba(8, 14, 22, 0.95);
      color: #e8f0ff;
      text-align: center;
      box-shadow: 0 0 18px rgba(57, 244, 183, 0.35), 0 14px 30px rgba(0, 0, 0, 0.5);
    }

    #task-complete-card h3 {
      margin: 0 0 10px;
      font-size: 22px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    #task-complete-card p {
      margin: 0 0 16px;
      font-size: 16px;
      line-height: 1.5;
    }

    #task-message:not(.hidden) ~ #task-complete-modal {
      opacity: 1;
      pointer-events: auto;
    }

  .bottom-home-button {
  position: fixed;
  bottom: 20px;
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 9999;
}

  </style>
</head>

<body>
  <%= render "task1" %>
</body>
</html>
