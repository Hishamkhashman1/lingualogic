  <head>
      <style>
    .tooltip-root {
      position: relative;
      cursor: help;
    }
    .tooltip-root .tooltip-content {
      position: absolute;
      top: 0%;
      left: 50%;
      transform: translate(-50%, calc(-100% - 15px));
      background: rgba(8, 14, 22, 0.95);
      border: 1px solid rgba(57, 244, 183, 0.6);
      border-radius: 12px;
      padding: 14px 18px;
      width: max-content;
      max-width: 360px;
      font-size: 16px;
      line-height: 1.6;
      font-weight: 500;
      color: #cffff6;
      box-shadow: 0 0 12px rgba(57, 244, 183, 0.35), 0 6px 20px rgba(0, 0, 0, 0.6);
      opacity: 0;
      transition: all 0.2s ease;
      text-align: center;
      white-space: normal;
      z-index: 30;
      pointer-events: none;
    }

    .tooltip-root .tooltip-content::before {
      content: "";
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      border-width: 8px;
      border-style: solid;
      border-color: rgba(57, 244, 183, 0.6) transparent transparent transparent;
      transition: opacity 0.2s;
      top: 100%;
    }

    .tooltip-root:hover .tooltip-content {
      opacity: 1;
    }

    .tooltip-root.invert .tooltip-content {
      top: 100%;
      transform: translate(-50%, 15px);
    }

    .tooltip-root.invert .tooltip-content::before {
      top: -15px;
      border-color: transparent transparent rgba(57, 244, 183, 0.6)
    }

    .task-block {
      padding: 4px 12px;
      border-radius: 6px;
      border: 1px solid rgba(90, 200, 255, 0.35);
      background: rgba(12, 22, 30, 0.9);
      color: #9bfef2;
      cursor: grab;
      user-select: none;
      font-size: 12px;
    }

    .task-block.active {
      border: 1px solid rgba(57, 244, 183, 0.6);
    }

    .speak-btn {
      width: 24px;
      height: 24px;
      border-radius: 999px;
      border: 1px solid rgba(57, 244, 183, 0.6);
      background: rgba(8, 14, 22, 0.85);
      color: #cffff6;
      font-size: 13px;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      box-shadow: 0 0 8px rgba(57, 244, 183, 0.28), 0 0 14px rgba(90, 200, 255, 0.2);
    }

    .speak-btn:hover,
    .speak-btn:focus-visible {
      box-shadow: 0 0 12px rgba(57, 244, 183, 0.45), 0 0 20px rgba(90, 200, 255, 0.3);
      outline: none;
    }

    .speak-btn--pill {
      position: absolute;
      top: -6px;
      right: -6px;
      width: 20px;
      height: 20px;
      font-size: 11px;
    }

    #task-complete-modal {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(6, 12, 18, 0.65);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 80;
    }

    #task-complete-card {
      width: min(520px, 92vw);
      padding: 22px 24px;
      border-radius: 16px;
      border: 1px solid rgba(57, 244, 183, 0.55);
      background: rgba(8, 14, 22, 0.95);
      color: #e8f0ff;
      text-align: center;
      box-shadow: 0 0 18px rgba(57, 244, 183, 0.35), 0 14px 30px rgba(0, 0, 0, 0.5);
    }

    #task-complete-card h3 {
      margin: 0 0 10px;
      font-size: 22px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    #task-complete-card p {
      margin: 0 0 16px;
      font-size: 16px;
      line-height: 1.5;
    }

    #task-message:not(.hidden) ~ #task-complete-modal {
      opacity: 1;
      pointer-events: auto;
    }

    .bottom-home-button {
      width: 100%;
      text-align: center;
    }

  </style>
</head>

<body>
  <span class="tooltip-wrap">
    <%= link_to "Play Now!", new_monster_path, class: "cta-button has-tooltip", data: { tooltip: "ミニチャレンジ画面へ行くよ！準備できたら押してね。" } %>
    <button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
  </span>
  <h1> Time to get the apple! </h1>

  <div class="tooltip-wrap tooltip-wrap--block">
    <div id="task-info" class="has-tooltip" data-tooltip="このレベルの説明だよ。ミニチャレンジを解いて、MOVE/JUMPでリンゴを取りに行こう！">
      <h2> Easy apple </h2>
      <%# <%= @monster_task.task.goal %>
      <p> Level: 1 </p>
      <p> WIP </p>
    </div>
    <button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
  </div>

  <div id="task-phaserjs" data-controller="task1"
  data-task1-img-background-value="<%= image_path("background_2.png") %>"
  data-task1-img-monster-right-value="<%= image_path("spritesheet-cat-2.png") %>"
  data-task1-img-apple-value="<%= image_path("apple-s.png") %>"
  data-task1-img-transparent-box-value="<%= image_path("transparent_box.png") %>"
  data-task1-img-pink-box-value="<%= image_path("pink_box.png") %>"
  data-task1-reward-exp-value="<%= @monster_task.task.reward_exp %>"
  data-task1-reward-item1-value="<%= @monster_task.task.reward_item1 %>"
  data-task1-reward-item2-value="<%= @monster_task.task.reward_item2 %>"
  data-task1-reward-money-value="<%= @monster_task.task.reward_money %>"
  data-task1-reward-health-value="<%= @monster_task.task.reward_health %>"
  data-task1-reward-energy-value="<%= @monster_task.task.reward_energy %>"
  data-task1-completed-value="<%= @monster_task.progress%>"
  >

    <div id="task-message" data-task1-target="messagebox" class="hidden" style="gap: 10px; margin-bottom: 18px; padding: 12px; border-radius: 12px; border: 1px solid rgba(57, 244, 183, 0.35); background: rgba(8, 14, 22, 0.8);">
      <h3 id="task-message-status" data-task1-target="message"> Task Status </h3>
      <p id="task-message-info" data-task1-target="info"> Task message </p>
      <div data-controller="monster-tasks">
        <p id="task-message-link" data-task1-target="link" data-monster-tasks-target="claim" data-action="click->monster-tasks#rewards"> <%= link_to "Return Home", monster_path(@monster), class: "cta-button" %> </p>
      </div>

      <div id="hidden-rewards-form">
        <%# hidden button that runs monster_task controller's #rewards function - updates rewards %>
        <%= button_to "Claim Rewards", rewards_monster_task_path(@monster_task), method: :patch, form: {style: "display: none", data: {task1_target: "rewardsclaim"} } %>
      </div>

    </div>

    <div id="task-complete-modal">
      <div id="task-complete-card">
         <h3 id="task-message-status" data-task1-target="modalmessage"> Task Status </h3>
        <h3>Congrats! よくできました! 😆</h3>
        <p>Task finished. Great job!</p>
         <p id="task-message-info" data-task1-target="modalinfo"> Task message </p>
        <%= link_to "Continue Quest", monster_path(@monster_task.monster), class: "cta-button" %>
      </div>
    </div>

    <div id="task-split" style="display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 16px; align-items: stretch;">
      <div id="task-phaser" style="width: 100%; height: 360px;"></div>
<div id="task-code-panel" style="display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: 12px; border: 1px solid rgba(57, 244, 183, 0.35); background: rgba(8, 14, 22, 0.8);">
  <div class="task-code-header" style="font-family: monospace; letter-spacing: 0.12em; text-transform: uppercase;">
    Code Console
  </div>

  <div class="tooltip-wrap tooltip-wrap--block">
    <div
      id="task-mini-challenge"
      class="has-tooltip"
      data-tooltip="ここではMOVEだけを使うよ。ブロックを見て、どう動くか学ぼう。"
      style="display: flex; flex-direction: column; gap: 8px; padding: 10px; border-radius: 10px; border: 1px solid rgba(90, 200, 255, 0.35); background: rgba(6, 12, 18, 0.85); color: #cfe9ff; font-family: monospace;"
    >
      <div style="font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;">
        Mini Challenge
      </div>

      <div style="font-size: 13px; color: #e8f0ff;">
        Drag the command you need to reach the apple.
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 6px;">
        <div
          class="task-block has-tooltip"
          draggable="true"
          data-value="MOVE"
          data-tooltip="1マス前に進む動きだよ。"
          style="position: relative; padding: 4px 26px 4px 8px; border-radius: 6px; border: 1px solid rgba(57, 244, 183, 0.6); background: rgba(12, 22, 30, 0.9); color: #9bfef2; cursor: grab; user-select: none; font-size: 12px;"
        >
          MOVE
          <button
            type="button"
            class="speak-btn speak-btn--pill"
            aria-label="読み上げ"
            data-controller="tooltip-speaker"
            data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag"
          >🔊</button>
        </div>
      </div>

      <div style="display: grid; gap: 4px; font-size: 12px; color: #9bfef2;">
        <div>Use MOVE to go to the apple.</div>
      </div>

      <div style="font-size: 11px; color: #9bfef2; opacity: 0.8;">
        Hint: No jump needed in this level.
      </div>
    </div>

    <button
      type="button"
      class="speak-btn"
      aria-label="読み上げ"
      data-controller="tooltip-speaker"
      data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag"
    >🔊</button>
  </div>

<div class="tooltip-wrap tooltip-wrap--block" style="flex: 1; width: 100%;">
  <div
    id="task-drop-zone"
    class="has-tooltip"
    data-tooltip="ここに MOVE をドラッグして入れてね。1回で1歩進むよ。"
    style="flex: 1; width: 100%; min-height: 160px; padding: 10px; border-radius: 8px; border: 1px dashed rgba(90, 200, 255, 0.4); background: rgba(6, 12, 18, 0.9); color: #e8f0ff; font-family: monospace; display: flex; flex-direction: column; gap: 8px;"
  >
    <div id="task-drop-placeholder" style="opacity: 0.7;">
      Drag MOVE here
    </div>
    <div id="task-command-list" style="display: flex; flex-direction: column; gap: 6px;"></div>
  </div>

  <button
    type="button"
    class="speak-btn"
    aria-label="読み上げ"
    data-controller="tooltip-speaker"
    data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag"
  >🔊</button>
</div>

  <div class="tooltip-wrap" style="align-self: flex-start;">
    <button
      id="task-run"
      class="has-tooltip"
      data-tooltip="書いたMOVEを実行するよ。"
      style="align-self: flex-start;"
    >
      Run
    </button>

    <button
      type="button"
      class="speak-btn"
      aria-label="読み上げ"
      data-controller="tooltip-speaker"
      data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag"
    >🔊</button>
  </div>

  <div class="tooltip-wrap tooltip-wrap--block">
    <pre
      id="task-output"
      class="has-tooltip"
      data-tooltip="ここに結果が出るよ。"
      style="min-height: 80px; margin: 0; padding: 8px; border-radius: 8px; border: 1px solid rgba(90, 200, 255, 0.2); background: rgba(6, 12, 18, 0.85); color: #9bfef2; font-family: monospace;"
    ></pre>

    <button
      type="button"
      class="speak-btn"
      aria-label="読み上げ"
      data-controller="tooltip-speaker"
      data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag"
    >🔊</button>
  </div>
</div>

  <%# <div id="task-phaserjs-2x">
    <p> Test Task </p> %>
  </div>

  <%# <p>v3 </p> %>

<div class="bottom-home-button">
  <%= link_to "Back to Monster Home",
  monster_path(@monster_task.monster),
  class: "btn btn-secondary" %>
</div>
</body>
