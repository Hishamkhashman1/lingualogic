<!DOCTYPE html>
<html>

<head>
  <script src="https://cdn.jsdelivr.net/npm/phaser@3.60.0/dist/phaser-arcade-physics.min.js"></script>
  <%= javascript_import_module_tag "tasks/task1" %>
</head>

<body>
  <div>

    <h1><%= t("tasks.level5.title") %></h1>

<%# Task Starts %>
    <div>
      <div id="task-info" class="tooltip-root">
        <h2><%= t("tasks.level5.info_title") %></h2>
        <%# <%= @monster_task.task.goal %>
        <p><%= t("tasks.level5.level_label", level: 5) %></p>
        <p><%= t("tasks.level5.description") %></p>
        <div class="tooltip-content"><%= t("tasks.level5.info_tooltip_html").html_safe %></div>
      </div>
      <button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
    </div>

    <div id="task-phaserjs" data-controller="task5"
    data-task5-img-background-value="<%= image_path("background_1.png") %>"
    data-task5-img-monster-right-value="<%= image_path("spritesheet-cat-2.png") %>"
    data-task5-img-apple-value="<%= image_path("apple-s.png") %>"
    data-task5-img-transparent-box-value="<%= image_path("transparent_box.png") %>"
    data-task5-img-pink-box-value="<%= image_path("pink_box.png") %>"
    data-task5-img-funny-hat-value="<%= image_path("top-hat.png") %>"
    data-task5-hat-equipped-value="<%= @monster_task.monster.accessory %>"

    data-task5-reward-exp-value="<%= @monster_task.task.reward_exp %>"
    data-task5-reward-item1-value="<%= @monster_task.task.reward_item1 %>"
    data-task5-reward-item2-value="<%= @monster_task.task.reward_item2 %>"
    data-task5-reward-money-value="<%= @monster_task.task.reward_money %>"
    data-task5-reward-health-value="<%= @monster_task.task.reward_health %>"
    data-task5-reward-energy-value="<%= @monster_task.task.reward_energy %>"
    data-task5-completed-value="<%= @monster_task.progress %>"
    data-task5-task-id-value="<%= @monster_task.task.id %>"
    data-task5-monster-id-value="<%= @monster_task.monster_id %>"
    data-task5-monster-health-value="<%= @monster_task.monster.health %>"
    >

      <div id="task-message" data-task5-target="messagebox" class="hidden" style="gap: 10px; margin-bottom: 18px; padding: 12px; border-radius: 12px; border: 1px solid rgba(57, 244, 183, 0.35); background: rgba(8, 14, 22, 0.8);">
        <h3 id="task-message-status" data-task5-target="message"><%= t("tasks.shared.task_status") %></h3>
        <p id="task-message-info" data-task5-target="info"><%= t("tasks.shared.task_message") %></p>
        <div data-controller="monster-tasks">
          <p id="task-message-link" data-tasks-target="link" data-monster-tasks-target="claim" data-action="click->monster-tasks#rewards"> <%= link_to t("tasks.shared.return_home"), monster_path(@monster), class: "cta-button" %> </p>
        </div>

        <div id="hidden-rewards-form">
          <%# hidden button that runs monster_task controller's #rewards function - updates rewards %>
          <%= button_to t("tasks.shared.claim_rewards"), rewards_monster_task_path(@monster_task), method: :patch, form: {style: "display: none", data: {task5_target: "rewardsclaim", page_transition_ignore: true} } %>
        </div>

      </div>

      <div id="task-complete-modal">
        <div id="task-complete-card">
          <h3 id="task-message-status" data-task5-target="modalmessage"><%= t("tasks.shared.task_status") %></h3>
          <h3><%= t("tasks.shared.congrats") %></h3>
          <p><%= t("tasks.shared.finished") %></p>
          <p id="task-message-info" data-task5-target="modalinfo"><%= t("tasks.shared.task_message") %></p>
          <% reward_items = [] %>
          <% [@monster_task.task.reward_item1, @monster_task.task.reward_item2].each do |reward_name| %>
            <% next if reward_name.blank? %>
            <% if (item = Item.find_by(name: reward_name)) %>
              <% reward_items << item %>
            <% end %>
          <% end %>
          <% if reward_items.any? %>
            <div class="tama-inventory-list task-reward-list">
              <% reward_items.each do |item| %>
                <div class="tama-inventory-item">
                  <div class="tama-inventory-media">
                    <% if item.image.present? %>
                      <%= image_tag File.basename(item.image), alt: item.name, size: "56x56" %>
                    <% end %>
                  </div>
                  <div class="tama-inventory-meta">
                    <span class="tama-inventory-name"><%= item.name %></span>
                    <span class="tama-inventory-qty"><%= t("tasks.shared.reward_label") %></span>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
          <%= link_to t("tasks.shared.continue_quest"), monster_path(@monster_task.monster), class: "cta-button" %>
        </div>
      </div>

      <div id="task-split" style="display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 16px; align-items: stretch;">
        <div id="task-phaser" style="width: 100%; height: 360px;"></div>
        <div id="task-code-panel" style="display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: 12px; border: 1px solid rgba(57, 244, 183, 0.35); background: rgba(8, 14, 22, 0.8);">
          <div class="task-code-header" style="font-family: monospace; letter-spacing: 0.12em; text-transform: uppercase;"><%= t("tasks.shared.code_console") %></div>
          <div class="">
            <div id="task-mini-challenge" class="" style="display: flex; flex-direction: column; gap: 6px; padding: 8px; border-radius: 10px; border: 1px solid rgba(90, 200, 255, 0.35); background: rgba(6, 12, 18, 0.85); color: #cfe9ff; font-family: monospace;">
              <div class="tooltip-root" style="font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;">
                <%= t("tasks.shared.mini_challenge") %>
                <div class="tooltip-content"><%= t("tasks.level5.mini_tooltip_html").html_safe %></div>
              </div>
              <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                <div class="tooltip-root">
                  <div class="task-block active" draggable="true" data-value="isRunning">isRunning</div>
                  <button type="button" class="speak-btn speak-btn--pill" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
                  <div class="tooltip-content"><%= t("tasks.level5.tooltip_is_running_html").html_safe %></div>
                </div>
                <div class="tooltip-root">
                  <div class="task-block active" draggable="true" data-value="queue.length">queue.length</div>
                  <button type="button" class="speak-btn speak-btn--pill" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
                  <div class="tooltip-content"><%= t("tasks.level5.tooltip_queue_html").html_safe %></div>
                </div>
                <div class="tooltip-root">
                  <div class="task-block active" draggable="true" data-value="executeMove()">executeMove()</div>
                  <button type="button" class="speak-btn speak-btn--pill" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
                  <div class="tooltip-content"><%= t("tasks.level5.tooltip_move_html").html_safe %></div>
                </div>
                <div class="tooltip-root">
                  <div class="task-block" draggable="true" data-value="executeJump()">executeJump()</div>
                  <button type="button" class="speak-btn speak-btn--pill" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
                  <div class="tooltip-content"><%= t("tasks.level5.tooltip_jump_html").html_safe %></div>
                </div>
                <div class="tooltip-root">
                  <div class="task-block" draggable="true" data-value="monster.hp">monster.hp</div>
                  <button type="button" class="speak-btn speak-btn--pill" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
                  <div class="tooltip-content"><%= t("tasks.level5.tooltip_hp_html").html_safe %></div>
                </div>
                <div class="tooltip-root">
                  <div class="task-block" draggable="true" data-value="speed">speed</div>
                  <button type="button" class="speak-btn speak-btn--pill" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
                  <div class="tooltip-content"><%= t("tasks.level5.tooltip_speed_html").html_safe %></div>
                </div>
                <div class="tooltip-root">
                  <div class="task-block" draggable="true" data-value="run()">run()</div>
                  <button type="button" class="speak-btn speak-btn--pill" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
                  <div class="tooltip-content"><%= t("tasks.level5.tooltip_run_html").html_safe %></div>
                </div>
              </div>
              <div style="display: grid; gap: 4px; font-size: 12px;">
                <div>IF <span><span class="task-slot tooltip-root" data-slot="1" style="display: inline-block; min-width: 110px; padding: 2px 6px; border-radius: 6px; border: 1px dashed rgba(90, 200, 255, 0.5); background: rgba(8, 14, 22, 0.9); color: #e8f0ff;">____<div class="tooltip-content"><%= t("tasks.level5.slot1_tooltip_html").html_safe %></div></span><button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button></span> AND <span><span class="task-slot tooltip-root" data-slot="2" style="display: inline-block; min-width: 110px; padding: 2px 6px; border-radius: 6px; border: 1px dashed rgba(90, 200, 255, 0.5); background: rgba(8, 14, 22, 0.9); color: #e8f0ff;">____<div class="tooltip-content"><%= t("tasks.level5.slot2_tooltip_html").html_safe %></div></span><button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button></span></div>
                <div>IF cmd == "MOVE" -> <span><span class="task-slot tooltip-root" data-slot="3" style="display: inline-block; min-width: 120px; padding: 2px 6px; border-radius: 6px; border: 1px dashed rgba(90, 200, 255, 0.5); background: rgba(8, 14, 22, 0.9); color: #e8f0ff;">____<div class="tooltip-content"><%= t("tasks.level5.slot3_tooltip_html").html_safe %></div></span><button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button></span></div>
                <div>IF cmd == "JUMP" -> <span><span class="task-slot tooltip-root" data-slot="4" style="display: inline-block; min-width: 120px; padding: 2px 6px; border-radius: 6px; border: 1px dashed rgba(90, 200, 255, 0.5); background: rgba(8, 14, 22, 0.9); color: #e8f0ff;">____<div class="tooltip-content"><%= t("tasks.level5.slot4_tooltip_html").html_safe %></div></span><button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button></span></div>
              </div>
              <div style="font-size: 11px; color: #9bfef2; opacity: 0.8;"><%= t("tasks.level5.hint") %></div>
            </div>
            <button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
          </div>
            <div style="flex: 1; width: 100%;">
            <div class="tooltip-root" style="flex: 1; width: 100%;">
              <textarea id="task-code" spellcheck="false" style="flex: 1; width: 100%; min-height: 160px; resize: vertical; padding: 10px; border-radius: 8px; border: 1px solid rgba(90, 200, 255, 0.4); background: rgba(6, 12, 18, 0.9); color: #e8f0ff; font-family: monospace;">MOVE
  MOVE
  JUMP
  MOVE
  MOVE</textarea>
              <div class="tooltip-content"><%= t("tasks.level5.code_tooltip_html").html_safe %></div>
            </div>
            <button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
          </div>
          <div style="align-self: flex-start;">
            <button id="task-run" class="tooltip-root" style="align-self: flex-start;"><%= t("tasks.shared.run") %><div class="tooltip-content"><%= t("tasks.level5.run_tooltip_html").html_safe %></div></button>
            <button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
          </div>
          <div>
            <div class="tooltip-root" style="flex: 1;">
              <pre id="task-output" style="min-height: 80px; margin: 0; padding: 8px; border-radius: 8px; border: 1px solid rgba(90, 200, 255, 0.2); background: rgba(6, 12, 18, 0.85); color: #9bfef2; font-family: monospace;"></pre>
              <div class="tooltip-content"><%= t("tasks.level5.output_tooltip_html").html_safe %></div>
            </div>
              <button type="button" class="speak-btn" aria-label="読み上げ" data-controller="tooltip-speaker" data-action="click->tooltip-speaker#speak keydown.enter->tooltip-speaker#speak keydown.space->tooltip-speaker#speak mousedown->tooltip-speaker#blockDrag touchstart->tooltip-speaker#blockDrag">🔊</button>
          </div>
        </div>
      </div>

      <div class="bottom-home-button bottom-home-button--left">
        <%= link_to t("tasks.shared.back_home"),
        monster_path(@monster_task.monster),
        class: "btn btn-secondary btn-muted" %>
      </div>
    </div>

    <%# Task Ends %>

    <%# <div id="task-phaserjs-2x">
      <p> Test Task </p> %>
    </div>

    <%# <p>v3 </p> %>

</div>
</html>
</body>
</html>
